{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adilalperenciftci.github.io/schemas/identity-invariants.json",
  "title": "Identity invariant catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["invariants"],
  "properties": {
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "section",
          "summary",
          "evidence_class",
          "positive_cases",
          "negative_cases",
          "observe_cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(WIF|STS|OIDC|CKT|PAC|DMSA)-[A-Z]+-[0-9]{3}$"
          },
          "source": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "evidence_class": {
            "enum": [
              "spec-oracle",
              "local-adapter",
              "windows-observation",
              "entra-observation"
            ]
          },
          "positive_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "negative_cases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "observe_cases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
